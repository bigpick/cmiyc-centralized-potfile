# Copy to .env for local use. On Railway, set these in the service Variables tab
# instead (never commit a real .env).

# --- server (cmiyc serve) ---
# Railway injects PORT and, when you add a Postgres service and reference it,
# DATABASE_URL. Locally you supply both yourself.
PORT=8080
DATABASE_URL=postgres://user:pass@localhost:5432/cmiyc?sslmode=disable
# Shared bearer secret every API call must present. Generate a long random one:
#   openssl rand -hex 32
POOL_TOKEN=change-me-to-a-long-random-secret

# --- client (send / pull / submit / stats) ---
# Point the CLI at the deployed pool. Locally this is http://localhost:8080.
POOL_URL=https://your-service.up.railway.app
# POOL_TOKEN is shared with the server above.

# Who you are, so `send` does not need --author every time.
CMIYC_AUTHOR=zilla

# Pull/submit configuration.
CMIYC_RECIPIENT_KEY=./keys/korelogic-2026-pub.asc
CMIYC_CONTEST_EMAIL=sub-2026@contest.korelogic.com
# Optional: sign submissions with your registered team key.
CMIYC_SIGN_KEY=./keys/team-private.asc
CMIYC_SIGN_PASSPHRASE=

# Optional: only if you want `submit` to send email itself instead of the
# assisted-manual default.
CMIYC_SMTP_USER=
CMIYC_SMTP_PASS=
CMIYC_SMTP_FROM=
